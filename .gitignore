# Python
__pycache__/
*.py[cod]

# OS noise
.DS_Store
Thumbs.db

# Editor local settings
.vscode/
.idea/

# Local build/work outputs (verification scripts take an external workdir,
# but guard against accidental in-repo runs)
*.elf
*.map
*.hex
*.bin
/work/

# pytest / uv test environment (tests/uv.lock IS tracked)
.venv/
.pytest_cache/
# pytest-embedded-arduino-cli build output next to each sketch
tests/sketches/**/build/

# Per-machine platform overrides. arduino-cli reads platform.local.txt next to
# platform.txt; it names paths that exist on one machine only, so it must never
# be committed (docs/debugger.ja.md and docs/local-install.ja.md use it).
platform.local.txt
programmers.local.txt
boards.local.txt

# Bench-local configuration for the manual tests (tests/.env.example documents it)
tests/.env
# Generated from the environment by tests/manual/env_config.py before each build
tests/manual/**/env_config.h

# Tools the tests need, fetched by tools/index/fetch_tools.py. Not source.
.tools/
