// en: One command byte (control byte 0x00 before it). False when the module did not acknowledge.
// ja: コマンド1バイト（前に制御バイト0x00）。モジュールが応答しなければfalse。
static bool command(uint8_t c)
{
    Wire.beginTransmission(OLED_ADDR);
    Wire.write(0x00);
    Wire.write(c);
    return Wire.endTransmission() == 0;
}

// en: Point the display's RAM at a page (0-7) and a column (0-127).
// ja: 表示側のRAMの書く位置を、ページ（0〜7）と列（0〜127）で指定する。
static void moveTo(uint8_t page, uint8_t column)
{
    const uint8_t c = column + COLUMN_OFFSET;
    command(0xB0 | page);
    command(0x00 | (c & 0x0F));
    command(0x10 | (c >> 4));
}

// en: Display data bytes (control byte 0x40), in pieces that fit Wire's 32-byte buffer.
// ja: 表示データ（制御バイト0x40）。Wireの32バイトのバッファに収まる大きさに分けて送る。
static void data(const uint8_t *bytes, size_t length)
{
    while (length > 0) {
        const size_t n = length < 16 ? length : 16;
        Wire.beginTransmission(OLED_ADDR);
        Wire.write(0x40);
        Wire.write(bytes, n);
        Wire.endTransmission();
        bytes += n;
        length -= n;
    }
}

static void clearScreen()
{
    static const uint8_t zeros[16] = {0};
    for (uint8_t page = 0; page < 8; page++) {
        moveTo(page, 0);
        for (uint8_t i = 0; i < 128 / 16; i++) {
            data(zeros, sizeof zeros);
        }
    }
}

// en: Text on one 8-pixel row (page 0-7) from a column, 6 pixels a character (5 and a gap), 21 to a row.
// ja: 8ドットの1行（ページ0〜7）に、列から文字を書く。1文字6ドット（5ドットと隙間）、1行21文字。
static void drawText(uint8_t page, uint8_t column, const char *text)
{
    moveTo(page, column);
    for (; *text && column <= 128 - 6; text++, column += 6) {
        const char ch = (*text >= 0x20 && *text <= 0x7E) ? *text : '?';
        uint8_t glyph[6];
        memcpy(glyph, FONT[ch - 0x20], 5);
        glyph[5] = 0;
        data(glyph, sizeof glyph);
    }
}

static bool oledBegin()
{
    // en: The usual SH1106 start: off, clock, 64 rows, no offset, start line 0, DC-DC on, mirrored
    // en: (connector at the top), contrast, precharge, VCOM, follow RAM, not inverted, on.
    // ja: SH1106の一般的な始め方: 消灯、クロック、64行、ずれ無し、開始行0、DC-DCを入れる、向き（端子が上）、
    // ja: コントラスト、プリチャージ、VCOM、RAMに従う、反転しない、点灯。
    static const uint8_t init[] = {0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00, 0x40, 0xAD, 0x8B, 0xA1, 0xC8,
                                   0xDA, 0x12, 0x81, 0x80, 0xD9, 0x22, 0xDB, 0x35, 0xA4, 0xA6};
    for (uint8_t c : init) {
        if (!command(c)) {
            return false;
        }
    }
    clearScreen();
    return command(0xAF);
}

static bool ready;

void setup()
{
#if USE_DEBUG_PADS
    SerialUSB.begin();
    // en: Until the next reset no WCH-Link or OEP probe can attach: upload over USB (above).
    // ja: 次のリセットまでWCH-LinkやOEPのprobeから接続できない。書き込みはUSBで（上）。
    CH32RV.releaseDebugPins();
#endif
    if (!Wire.begin(SDA_PIN, SCL_PIN, 400000)) {
        return;   // en: these pins cannot carry I2C here / ja: この端子ではI2Cにできない
    }
    ready = oledBegin();
    if (ready) {
        drawText(0, 0, "Hello, SH1106!");
        drawText(2, 0, "CH32RV Arduino");
        drawText(4, 0, "SDA ");
        drawText(4, 24, digitalPinToName(SDA_PIN));
        drawText(4, 54, "SCL ");
        drawText(4, 78, digitalPinToName(SCL_PIN));
    }
}

void loop()
{
    if (!ready) {
        return;
    }
    static uint32_t last;
    if (millis() - last >= 500) {
        last = millis();
        char text[22];
        snprintf(text, sizeof text, "uptime %lu.%lu s   ", (unsigned long)(last / 1000),
                 (unsigned long)(last % 1000 / 100));
        drawText(6, 0, text);
    }
}
