// en: Show text and a counter on an SH1106 128x64 OLED over I2C, with Wire alone (no display library).
// ja: SH1106（128x64のOLED、I2C）に文字とカウンタを出す。Wireだけで動かす（表示のライブラリは使わない）。
// en: Wiring and operation: README.md.
// ja: 配線と操作: README.ja.md。

/* requires: I2C1 */

#include <Wire.h>

// en: The pins: this chip's default I2C pads. The WeAct CH32X035 (F8U6) has I2C only on the debug pads
// en: PC18 / PC19 (or the USB pads PC16 / PC17): there use PC18 / PC19 and USE_DEBUG_PADS 1.
// ja: 端子。この石の既定のI2Cの端子。WeAct CH32X035（F8U6）ではI2Cがデバッグの端子PC18 / PC19（かUSBの端子
// ja: PC16 / PC17）にしか出ていないので、PC18 / PC19とUSE_DEBUG_PADS 1にする。
static const int SDA_PIN = SDA;
static const int SCL_PIN = SCL;
// static const int SDA_PIN = PC18;
// static const int SCL_PIN = PC19;

// en: 1 when the pins above are the debug interface's pads: the debugger lets go of them until the next reset
// en: (no WCH-Link or OEP probe can attach), and a USB device is kept up so the next sketch uploads over USB.
// ja: 上の端子がデバッグの端子のときは1。次のリセットまでデバッガーが端子を手放す（WCH-LinkやOEPのprobeから
// ja: 接続できない）。次のスケッチをUSBで書き込めるよう、USBのデバイスを動かしておく。
#define USE_DEBUG_PADS 0

// en: The module's address: 0x3C on most, 0x3D when its address jumper is moved.
// ja: モジュールのアドレス。たいてい0x3C、アドレスのジャンパーを変えると0x3D。
static const uint8_t OLED_ADDR = 0x3C;

#if USE_DEBUG_PADS
#include <CH32RV.h>
// en: With the debug pads given away, USB is the only way to upload the next sketch: keep a USB device up
// en: (SerialUSB carries the DFU runtime), so the board's ch32rv-app:// port or serial port still uploads.
// ja: デバッグの端子を手放すと、次の書き込みはUSBしか無い。USBのデバイスを動かしておく（SerialUSBにDFUランタイムが
// ja: 付く）ので、基板のch32rv-app://の口かシリアルポートから書き込める。
#include <CH32RVUsbDevice.h>
#endif

// en: SH1106's RAM is 132 columns wide; a 128-pixel panel sits at column 2.
// ja: SH1106のRAMは132列あり、128ドットの画面は2列目から始まる。
static const uint8_t COLUMN_OFFSET = 2;

