# Repository root: uv run --project tests --locked --extra hardware --env-file tests/.env python tests/run_hardware.py ...
# Copy this file; uv loads only the explicitly named .env.
CH32_TEST_CONFIG=tests/fixtures/bench.local.toml
OEP_HW_RESULTS=work/hardware-results
# Existing host-wide lock, shared with every hardware user; never copied per workspace.
OEP_HW_LOCK=/replace/with/existing/shared/bench.lock
# --bench / --out / --lock override these paths. Equipment identity and wiring stay in TOML.
# No minimum probe firmware and no implicit probe update or Flash backup.
