# Repository root: uv run --project tests --locked --extra hardware --env-file tests/.env python tests/run_hardware.py ...
# Copy this file to tests/.env. The address is the only setting: the probe, the chip and the probe's memo records
# say the rest (tests/harness/place.py). An OEP port, or a WCH-Link:
CH32RV_PROBE=oep://80f1b2d835d6/x035c8t6-pico
# CH32RV_PROBE=wchlink://A94B8F062EE9
# On a WCH-Link only (it keeps no record): the part when the chip ID leaves several (CH32V103 C8T6 / R8T6).
# CH32RV_CHIP=CH32V103C8T6
# A WCH-Link's core record, which it cannot keep (tests/RECORDS.ja.md §5): OEP_PORT_MEMO_<serial> for
# wchlink://<serial>, one per Link (oep-client's name; in single quotes: uv's env-file parser needs them around JSON).
# OEP_PORT_MEMO_<unit>_<PORT> overrides an OEP port's record on the probe in the tests/hw runs (a warning when they differ).
# OEP_PORT_MEMO_A94B8F062EE9='{"options": {"vio18": "3v3"}}'
OEP_HW_RESULTS=work/hardware-results
# --probe / --out override these. No minimum probe firmware and no implicit probe update or Flash backup.
#
# The bench's profiles (tests/hw/profiles.toml, tests/pyproject.toml's arduino_combos): the port of each,
# TEST_SERIAL_PORT_<PROFILE> (upper case, - as _). run_hardware.py --combo all runs every one (the full run);
# --combo <name> one. Every resident board has a profile; boards off the resident bench are temporary and have none.
TEST_SERIAL_PORT_V003F4P6=oep://30eda0e34a0e/v003f4p6
# A classic-ESP32 probe over its CH340 UART: no USB vendor interface and no mDNS, so name its tty.
TEST_SERIAL_PORT_V003F4U6_UIA=oep://0070070d9394/v003f4u6-uia?via=tty:/run/board-identify/by-id/esp32-d0wd-v3-0070070d9394
TEST_SERIAL_PORT_V006K8U6=oep://30eda0e343c6/v006k8u6
TEST_SERIAL_PORT_V103R8T6_EVT=oep://80f1b2d80a34/v103r8t6-evt
TEST_SERIAL_PORT_V103R8T6_CH549=wchlink://434A124C5596
TEST_SERIAL_PORT_V203C8T6=oep://e8f60ae84e28/v203c8t6
TEST_SERIAL_PORT_V203RBT6_CH549=wchlink://BC5F4B9807F7
TEST_SERIAL_PORT_V205RCT6_PICO=oep://30eda0e31108/v205rct6-pico
TEST_SERIAL_PORT_V307VCT6_LINKE=wchlink://38EF8F06BDC2
TEST_SERIAL_PORT_V407WEU6_YD_P4=oep://30eda0ea068b/v407weu6-yd-p4
TEST_SERIAL_PORT_X035C8T6_PICO=oep://80f1b2d835d6/x035c8t6-pico
TEST_SERIAL_PORT_X035C8T6_S3=oep://80f1b2d835d6/x035c8t6-s3
TEST_SERIAL_PORT_X315MCU6_PICO=oep://80f1b2d80946/x315mcu6-pico
TEST_SERIAL_PORT_L103C8T6_PICO=oep://e8f60ae84dc6/l103c8t6-pico
TEST_SERIAL_PORT_H417QEU6_PICO=oep://e8f60ae84dc2/h417qeu6-pico
TEST_SERIAL_PORT_H417QEU6_LINKE=wchlink://A94B8F062EE9
TEST_SERIAL_PORT_M030G8R7=wchlink://F90E8F067DFD
